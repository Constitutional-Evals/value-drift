{
  // The interpreter that has inspect-ai (and this repo installed with `pip install -e .`).
  // The Inspect VS Code extension resolves inspect-ai from the *selected* interpreter,
  // so pointing it anywhere else breaks the log viewer and the task runner.
  "python.defaultInterpreterPath": "/Library/Frameworks/Python.framework/Versions/3.12/bin/python3",
  "python.terminal.activateEnvironment": false,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python-envs.defaultEnvManager": "ms-python.python:system"
}
