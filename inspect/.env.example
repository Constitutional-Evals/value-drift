# Copy to .env and put your real key THERE, not here.
# .env is gitignored; this file is a committed template.

# Everything routes through OpenRouter so any model is one string change.
OPENROUTER_API_KEY=sk-or-v1-...

# Default model, so --model can be omitted.
INSPECT_EVAL_MODEL=openrouter/anthropic/claude-sonnet-5

INSPECT_LOG_DIR=./logs

# Cap concurrent Docker sandboxes. Each sample is its own container; raise or lower
# this to match the machine rather than reducing --epochs.
# NOTE the name: it is INSPECT_EVAL_MAX_SANDBOXES. `INSPECT_MAX_SANDBOXES` (which
# this file wrongly used until 2026-09-10) is silently ignored.
INSPECT_EVAL_MAX_SANDBOXES=20

# OpenRouter routes a slug to whichever upstream provider is cheapest/available, which
# can change quantisation and tool-use behaviour between runs. Uncomment to pin.
# OPENROUTER_PROVIDER_ORDER=anthropic
